# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

.DS_STORE

# Data bundle (symlink/mount) + writable ingest dirs
data
data-gmail/
data-uploads/
